---
import { config } from "../../config/features";
---
<section class="hero hero-grid">
  <div class="hero-copy reveal">
    <p class="eyebrow">Enterprise Systems • Application Security • Cloud Modernization</p>
    <h1>
      Gibson Tech Works.<br />
      <span class="blue">The technology just works—</span><br />
      <span class="gold">because good architecture works.</span>
    </h1>
    <p class="lead">
      <strong>Gibson Tech, LLC</strong> delivers high-impact systems architecture, OAuth 2.0 / Okta CIAM integrations, and penetration-test audit defense for enterprise engineering organizations. We turn fragile legacy integrations into observable, high-throughput platforms that pass audits on the first attempt.
    </p>

    <div class="actions">
      <!-- Feature Flag Check: Immediate commercial action vs. clean discovery -->
      {config.flags.showDetailedHeroCta ? (
        <>
          <a class="button gold" href="#capabilities">Explore Consulting Services</a>
          <a class="button solid" href="mailto:jgsteeler@gmail.com?subject=Gibson%20Tech%20Consulting%20Inquiry">Initiate C2C Engagement</a>
        </>
      ) : (
        <>
          <a class="button solid" href="#capabilities">Explore Capabilities</a>
          <a class="button ghost" href={config.linkedInUrl} target="_blank" rel="noopener">LinkedIn Company Page ↗</a>
        </>
      )}
    </div>
  </div>
</section>
