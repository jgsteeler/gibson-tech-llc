---
import SiteHead from "../components/home/SiteHead.astro";
import ConsultingPage from "../components/ConsultingPage.vue";
import { config } from "../config/features";
import "../styles/home.css";

export function getStaticPaths() {
  return config.flags.showSmallBusinessConsulting ? [{ params: { slug: "consulting" } }] : [];
}

const pageTitle = "Custom Software & Workflow Automation | Gibson Tech";
const pageDescription =
  "Custom web apps and workflow automation that reduce manual work for local businesses, delivered with practical architecture and short, validated milestones.";
---

<html lang="en">
  <head>
    <SiteHead title={pageTitle} description={pageDescription} />
  </head>
  <body>
    <ConsultingPage />
  </body>
</html>
