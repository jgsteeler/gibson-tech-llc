---
import "../styles/home.css";
import Topbar from "../components/home/Topbar.astro";
import HeroSection from "../components/home/HeroSection.astro";
import PlatformSection from "../components/home/PlatformSection.astro";
import ProductsSection from "../components/home/ProductsSection.astro";
import ConsultingCalloutSection from "../components/home/ConsultingCalloutSection.astro";
import ServicesSection from "../components/home/ServicesSection.astro";
import AboutSection from "../components/home/AboutSection.astro";
import SiteFooter from "../components/home/SiteFooter.astro";
import SiteHead from "../components/home/SiteHead.astro";

const pageTitle = "Gibson Tech | Enterprise Software Architecture & Application Security";
const pageDescription =
  "Gibson Tech, LLC delivers enterprise systems architecture, OAuth/Okta CIAM integrations, penetration-test audit defense, and pragmatic AI engineering mentorship.";
---

<html lang="en">
  <head>
    <SiteHead title={pageTitle} description={pageDescription} />
  </head>
  <body>
    <div class="texture"></div>

    <Topbar />

    <main class="shell">
      <HeroSection />
      <PlatformSection />
      <ProductsSection />
      <ConsultingCalloutSection />
      <ServicesSection />
      <AboutSection />
    </main>

    <SiteFooter />
  </body>
</html>
