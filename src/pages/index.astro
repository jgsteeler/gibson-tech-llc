---
import "../styles/home.css";
import Topbar from "../components/home/Topbar.vue";
import HeroSection from "../components/home/HeroSection.vue";
import ProductsSection from "../components/home/ProductsSection.vue";
import ConsultingCalloutSection from "../components/home/ConsultingCalloutSection.vue";
import ServicesSection from "../components/home/ServicesSection.vue";
import AboutSection from "../components/home/AboutSection.vue";
import ContactSection from "../components/home/ContactSection.vue";
import SiteFooter from "../components/home/SiteFooter.vue";
import ThemeToggle from "../components/home/ThemeToggle.vue";
import SiteHead from "../components/home/SiteHead.astro";
import { config } from "../config/features";

const pageTitle = "Gibson Tech | Architecture & Application Security Advisory";
const pageDescription =
  "Senior systems architecture and application security advisory for teams modernizing APIs, identity, and cloud platforms. Approximately 25 years of enterprise experience.";
---

<html lang="en">
  <head>
    <SiteHead title={pageTitle} description={pageDescription} />
  </head>
  <body>
    <div class="texture"></div>

    <Topbar config={config}>
      <ThemeToggle client:load />
    </Topbar>

    <main class="shell">
      <HeroSection config={config} />
      <ProductsSection config={config} />
      <ConsultingCalloutSection config={config} />
      <AboutSection />
      <ServicesSection config={config} />
      <ContactSection config={config} />
    </main>

    <SiteFooter config={config} />
  </body>
</html>
