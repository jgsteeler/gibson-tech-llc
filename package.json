{
  "name": "gibson-tech-site",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "description": "Gibson Tech marketing website built with Astro",
  "scripts": {
    "dev": "astro dev --open",
    "build": "npm run check && astro build",
    "check": "astro sync && vue-tsc --noEmit",
    "preview": "astro preview",
    "test:e2e": "playwright test",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.1.1",
    "astro": "^7.4.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "~7.0.2",
    "vue-tsc": "^3.3.13"
  }
}
